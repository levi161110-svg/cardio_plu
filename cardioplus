// ==========================================
// 7. CARDIOIA (ASSISTENTE VIRTUAL GERAL)
// ==========================================
class TelaCardioIA extends StatefulWidget {
  const TelaCardioIA({Key? key}) : super(key: key);

  @override
  State<TelaCardioIA> createState() => _TelaCardioIAState();
}

class _TelaCardioIAState extends State<TelaCardioIA> {
  final TextEditingController _mensagemController = TextEditingController();
  final List<Map<String, String>> _mensagens = [
    {
      'remetente': 'ia',
      'texto': 'Olá! Sou o CardioIA, seu assistente educativo. Como posso ajudar com dúvidas sobre a saúde do seu coração hoje?'
    }
  ];

  void _enviarPergunta(String pergunta) {
    if (pergunta.trim().isEmpty) return;

    setState(() {
      _mensagens.add({'remetente': 'user', 'texto': pergunta});
    });

    _mensagemController.clear();

    String respostaIA = "";
    String pLower = pergunta.toLowerCase();

    if (pLower.contains('reabilitação') || pLower.contains('reabilitacao')) {
      respostaIA = "A reabilitação cardiovascular é um conjunto de ações que busca auxiliar na recuperação e na melhora da capacidade funcional, sempre de acordo com a orientação dos profissionais de saúde.";
    } else if (pLower.contains('remedio') || pLower.contains('medicamento') || pLower.contains('remédio')) {
      respostaIA = "⚠️ Regra de Segurança: O CardioIA não pode indicar ou modificar medicamentos. Por favor, consulte o seu médico ou equipa de saúde sobre as suas prescrições.";
    } else if (pLower.contains('exercicio') || pLower.contains('exercício') || pLower.contains('treino')) {
      respostaIA = "⚠️ Importante: O CardioIA não prescreve treinos individualizados. A prática de exercícios deve seguir estritamente as orientações dadas pelos seus profissionais de saúde.";
    } else if (pLower.contains('tratamento')) {
      respostaIA = "Manter o tratamento é fundamental para evitar complicações do coração e manter a sua qualidade de vida no dia a dia!";
    } else {
      respostaIA = "Esta é uma ótima pergunta sobre saúde cardiovascular. Lembre-se de que o Cardio+ possui caráter educativo e não substitui a consulta com sua equipe de saúde.";
    }

    Future.delayed(const Duration(milliseconds: 600), () {
      setState(() {
        _mensagens.add({'remetente': 'ia', 'texto': respostaIA});
      });
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('CardioIA - Assistente Virtual'), backgroundColor: Colors.purple),
      body: Column(
        children: [
          Container(
            color: Colors.purple.shade50,
            padding: const EdgeInsets.all(8),
            child: const Text(
              'Nota: O CardioIA tem fins apenas educativos e não substitui profissionais de saúde.',
              textAlign: TextAlign.center,
              style: TextStyle(fontSize: 12, color: Colors.purple, fontWeight: FontWeight.bold),
            ),
          ),
          Expanded(
            child: ListView.builder(
              padding: const EdgeInsets.all(16),
              itemCount: _mensagens.length,
              itemBuilder: (context, index) {
                final msg = _mensagens[index];
                bool ehUser = msg['remetente'] == 'user';
                return Align(
                  alignment: ehUser ? Alignment.centerRight : Alignment.centerLeft,
                  child: Container(
                    margin: const EdgeInsets.only(bottom: 12),
                    padding: const EdgeInsets.all(14),
                    decoration: BoxDecoration(
                      color: ehUser ? Colors.purple : Colors.purple.shade100,
                      borderRadius: BorderRadius.circular(16),
                    ),
                    child: Text(
                      msg['texto']!,
                      style: TextStyle(
                        color: ehUser ? Colors.white : Colors.purple.shade900,
                        fontSize: 15,
                      ),
                    ),
                  ),
                );
              },
            ),
          ),
          SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            padding: const EdgeInsets.symmetric(horizontal: 8),
            child: Row(
              children: [
                _chipSugestao("O que é reabilitação cardiovascular?"),
                _chipSugestao("Por que continuar o tratamento?"),
                _chipSugestao("Pode indicar remédios?"),
              ],
            ),
          ),
          Padding(
            padding: const EdgeInsets.all(12.0),
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _mensagemController,
                    decoration: InputDecoration(
                      hintText: 'Digite sua dúvida...',
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(24)),
                      contentPadding: const EdgeInsets.symmetric(horizontal: 16),
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                FloatingActionButton(
                  mini: true,
                  backgroundColor: Colors.purple,
                  onPressed: () => _enviarPergunta(_mensagemController.text),
                  child: const Icon(Icons.send, color: Colors.white),
                )
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _chipSugestao(String texto) {
    return Padding(
      padding: const EdgeInsets.only(right: 6),
      child: ActionChip(
        label: Text(texto, style: const TextStyle(fontSize: 12, color: Colors.purple)),
        backgroundColor: Colors.purple.shade50,
        onPressed: () => _enviarPergunta(texto),
      ),
    );
  }
}
