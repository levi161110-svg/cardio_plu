class TelaMinhasMetas extends StatefulWidget {
  const TelaMinhasMetas({Key? key}) : super(key: key);

  @override
  State<TelaMinhasMetas> createState() => _TelaMinhasMetasState();
}

class _TelaMinhasMetasState extends State<TelaMinhasMetas> {
  int _semanaSelecionada = 1;

  final Map<int, Map<String, bool>> _metasPorSemana = {
    1: {
      'Participei da minha atividade orientada': true,
      'Li uma informação sobre saúde no Cardio+': true,
      'Segui as orientações da minha equipe': false,
      'Realizei a rotina de caminhada leve': false,
    },
    2: {
      'Realizei os exercícios de respiração guiada': false,
      'Conversei com um familiar sobre minha rotina': true,
      'Evitei alimentos com excesso de sal': true,
      'Fiz uma pergunta educativa ao CardioIA': false,
    },
    3: {
      'Li sobre os Sinais de Alerta no aplicativo': false,
      'Participei da minha atividade orientada': false,
      'Realizei os alongamentos suaves': true,
      'Mantive a rotina de cuidados recomendada': false,
    },
    4: {
      'Mantive os hábitos saudáveis durante toda a semana': false,
      'Li uma dica sobre alimentação saudável': true,
      'Explorei um novo tópico na biblioteca Aprender': false,
      'Organizei minha rotina de saúde com a família': false,
    },
  };

  @override
  Widget build(BuildContext context) {
    Map<String, bool> metasDaSemana = _metasPorSemana[_semanaSelecionada]!;
    int concluidas = metasDaSemana.values.where((e) => e).length;
    int total = metasDaSemana.length;
    double percentagem = concluidas / total;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Minhas Metas'),
        backgroundColor: Colors.green,
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  'Semana $_semanaSelecionada',
                  style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold, color: Colors.green),
                ),
                DropdownButton<int>(
                  value: _semanaSelecionada,
                  icon: const Icon(Icons.arrow_drop_down_circle, color: Colors.green),
                  items: [1, 2, 3, 4].map((int semana) {
                    return DropdownMenuItem<int>(
                      value: semana,
                      child: Text('Semana $semana', style: const TextStyle(fontWeight: FontWeight.bold)),
                    );
                  }).toList(),
                  onChanged: (int? novaSemana) {
                    if (novaSemana != null) {
                      setState(() {
                        _semanaSelecionada = novaSemana;
                      });
                    }
                  },
                ),
              ],
            ),
            const SizedBox(height: 12),

            Container(
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: Colors.green.shade50,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.green.shade300),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Progresso da Semana $_semanaSelecionada: $concluidas de $total metas',
                    style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16),
                  ),
                  const SizedBox(height: 8),
                  LinearProgressIndicator(
                    value: percentagem,
                    minHeight: 12,
                    backgroundColor: Colors.grey.shade300,
                    color: Colors.green,
                  ),
                  const SizedBox(height: 8),
                  Text(
                    '${(percentagem * 100).toInt()}% concluído',
                    style: const TextStyle(fontWeight: FontWeight.bold, color: Colors.green),
                  ),
                  const SizedBox(height: 8),
                  Text(
                    percentagem == 1.0
                        ? '"Parabéns! Você completou todas as metas desta semana!"'
                        : '"Você está indo bem! Continue cuidando da sua rotina."',
                    style: const TextStyle(fontStyle: FontStyle.italic),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 20),

            const Text(
              'Lista de Atividades da Semana:',
              style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 8),

            Expanded(
              child: ListView(
                children: metasDaSemana.keys.map((String chave) {
                  return CheckboxListTile(
                    title: Text(chave, style: const TextStyle(fontSize: 15)),
                    value: metasDaSemana[chave],
                    activeColor: Colors.green,
                    onChanged: (bool? valor) {
                      setState(() {
                        _metasPorSemana[_semanaSelecionada]![chave] = valor ?? false;
                      });
                    },
                  );
                }).toList(),
              ),
            ),

            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.green,
                  padding: const EdgeInsets.symmetric(vertical: 12),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
                ),
                icon: const Icon(Icons.autorenew, color: Colors.white),
