// ==========================================
// 4. MINHA SAÚDE & ATIVIDADES (COM IA INTEGRADA)
// ==========================================
class TelaMinhaSaude extends StatefulWidget {
  const TelaMinhaSaude({Key? key}) : super(key: key);

  @override
  State<TelaMinhaSaude> createState() => _TelaMinhaSaudeState();
}

class _TelaMinhaSaudeState extends State<TelaMinhaSaude> {
  bool _caminhada = false;
  bool _alongamento = false;
  bool _respiracao = false;

  final TextEditingController _duvidaController = TextEditingController();
  final List<Map<String, String>> _historicoIa = [
    {
      'remetente': 'ia',
      'texto': 'Olá! Sou a IA Guia de Exercícios. Tem dúvidas sobre como realizar a caminhada, alongamento ou respiração com segurança? Clique em uma opção abaixo ou digite sua dúvida!'
    }
  ];

  void _perguntarIa(String pergunta) {
    if (pergunta.trim().isEmpty) return;

    setState(() {
      _historicoIa.add({'remetente': 'user', 'texto': pergunta});
    });

    _duvidaController.clear();

    String resposta = "";
    String pLower = pergunta.toLowerCase();

    if (pLower.contains('caminhada') || pLower.contains('caminhar')) {
      resposta = "🚶‍♂️ **Como fazer a Caminhada com Segurança:**\n"
          "1. Use calçados confortáveis e planos.\n"
          "2. Mantenha a postura ereta e olhe para a frente.\n"
          "3. Mantenha um ritmo onde consiga conversar sem ficar sem ar.\n"
          "⚠️ Pare imediatamente se sentir tontura, dor no peito ou falta de ar excessiva.";
    } else if (pLower.contains('alongamento') || pLower.contains('alongar')) {
      resposta = "🧘‍♀️ **Como fazer Alongamentos Leves:**\n"
          "1. Movimente pescoço, ombros e braços de forma suave.\n"
          "2. Não mude bruscamente de posição para evitar tontura.\n"
          "3. Mantenha o alongamento por 10 a 15 segundos sem "
          "forçar a articulação e sem fazer movimentos bruscos.";
    } else if (pLower.contains('respiração') || pLower.contains('respiracao') || pLower.contains('respirar')) {
      resposta = "🫁 **Técnica de Respiração Guiada:**\n"
          "1. Sente-se confortavelmente numa cadeira com as costas apoiadas.\n"
          "2. Inspire lentamente pelo nariz contando até 3, expandindo o abdômen.\n"
          "3. Solte o ar devagar pela boca entreaberta contando até 4.\n"
          "4. Repita 5 a 10 vezes sem pressa.";
    } else if (pLower.contains('parar') || pLower.contains('sinal') || pLower.contains('dor')) {
      resposta = "⚠️ **Sinais de Alerta para PARAR o Exercício:**\n"
          "• Dor, aperto ou desconforto no peito, pescoço ou braço.\n"
          "• Tontura, suor frio ou visão embaçada.\n"
          "• Falta de ar intensa e desproporcional.\n"
          "Se sentir esses sintomas, sente-se, descanse e informe a sua equipe de saúde!";
    } else {
      resposta = "💡 Lembre-se: A prática de exercícios deve seguir as orientações da sua equipe de saúde. Mantenha um ritmo confortável, evite exageros e faça pausas sempre que necessário.";
    }

    Future.delayed(const Duration(milliseconds: 500), () {
      setState(() {
        _historicoIa.add({'remetente': 'ia', 'texto': resposta});
      });
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Minha Saúde & Atividades'), backgroundColor: Colors.pink),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            const Text('Acompanhamento Diário', style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, color: Colors.pink)),
            const SizedBox(height: 6),
            const Text('Marque as atividades que realizou hoje:'),
            const SizedBox(height: 12),

            CheckboxListTile(
              title: const Text('Caminhada orientada (15-30 min)'),
              value: _caminhada,
              activeColor: Colors.pink,
              onChanged: (val) => setState(() => _caminhada = val ?? false),
            ),
            CheckboxListTile(
              title: const Text('Alongamentos leves'),
              value: _alongamento,
              activeColor: Colors.pink,
              onChanged: (val) => setState(() => _alongamento = val ?? false),
            ),
            CheckboxListTile(
              title: const Text('Exercícios de Respiração'),
              value: _respiracao,
              activeColor: Colors.pink,
              onChanged: (val) => setState(() => _respiracao = val ?? false),
            ),

            const Divider(height: 32, thickness: 2),

            // SEÇÃO IA ASSISTENTE DE EXERCÍCIOS
            Row(
              children: const [
                Icon(Icons.smart_toy, color: Colors.pink, size: 28),
                SizedBox(width: 8),
                Text('IA Guia de Exercícios', style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold, color: Colors.pink)),
              ],
            ),
            const SizedBox(height: 6),
            const Text('Aprenda a executar cada movimento com segurança e sem esforço excessivo:', style: TextStyle(fontSize: 13, color: Colors.grey)),
            const SizedBox(height: 12),

            // Botões Rápidos para Dúvidas Comuns
            SingleChildScrollView(
              scrollDirection: Axis.horizontal,
              child: Row(
                children: [
                  _chipOpcao('Como fazer a Caminhada?', () => _perguntarIa('Como fazer a caminhada?')),
                  _chipOpcao('Dicas de Alongamento', () => _perguntarIa('Como fazer alongamento?')),
                  _chipOpcao('Técnica de Respiração', () => _perguntarIa('Como fazer a respiração?')),
                  _chipOpcao('Quando devo parar?', () => _perguntarIa('Quando devo parar?')),
                ],
              ),
            ),
            const SizedBox(height: 12),

            // Caixas de Conversa da IA
            Container(
              height: 230,
              padding: const EdgeInsets.all(12),
              decoration: BoxDecoration(
                color: Colors.pink.shade50,
                borderRadius: BorderRadius.circular(12),
                border: Border.all(color: Colors.pink.shade200),
              ),
              child: ListView.builder(
                itemCount: _historicoIa.length,
                itemBuilder: (context, index) {
                  final item = _historicoIa[index];
                  bool ehUser = item['remetente'] == 'user';
                  return Align(
                    alignment: ehUser ? Alignment.centerRight : Alignment.centerLeft,
                    child: Container(
                      margin: const EdgeInsets.only(bottom: 8),
                      padding: const EdgeInsets.all(10),
                      decoration: BoxDecoration(
                        color: ehUser ? Colors.pink : Colors.white,
                        borderRadius: BorderRadius.circular(10),
                        border: ehUser ? null : Border.all(color: Colors.pink.shade100),
                      ),
                      child: Text(
                        item['texto']!,
                        style: TextStyle(
                          color: ehUser ? Colors.white : Colors.black87,
                          fontSize: 14,
                        ),
                      ),
                    ),
                  );
                },
              ),
            ),
            const SizedBox(height: 12),

            // Campo para digitar dúvida sobre exercícios
            Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: _duvidaController,
                    decoration: InputDecoration(
                      hintText: 'Pergunte como fazer um exercício...',
                      contentPadding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
                      border: OutlineInputBorder(borderRadius: BorderRadius.circular(20)),
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                IconButton(
                  icon: const Icon(Icons.send, color: Colors.pink),
                  onPressed: () => _perguntarIa(_duvidaController.text),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  Widget _chipOpcao(String texto, VoidCallback aoClicar) {
    return Padding(
      padding: const EdgeInsets.only(right: 6),
      child: ActionChip(
        label: Text(texto, style: const TextStyle(fontSize: 12, color: Colors.pink, fontWeight: FontWeight.bold)),
        backgroundColor: Colors.white,
        side: const BorderSide(color: Colors.pink),
        onPressed: aoClicar,
      ),
    );
  }
}

